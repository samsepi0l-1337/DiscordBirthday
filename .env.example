# Discord 봇 토큰 (placeholder)
DISCORD_TOKEN=
# 대상 서버(길드) ID
GUILD_ID=
# 멤버에게 보낼 DM 내용
DM_MESSAGE="롤링 페이퍼를 작성해주세요"
# 제외할 사용자 ID (쉼표로 구분)
EXCLUDE_USER_IDS=
# 제외할 이름 (username/표시 이름/닉네임, 쉼표로 구분, 대소문자 무시)
EXCLUDE_NAMES=
# DM 전송 간격 (ms)
SEND_DELAY_MS=1500
# 응답 저장 파일 경로
RESPONSES_PATH=data/responses.json
# true이면 실제로 전송하지 않고 로그만 출력
DRY_RUN=false
